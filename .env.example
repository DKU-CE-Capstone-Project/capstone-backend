# capstone-backend 환경변수 — 값 없이 키만 커밋한다.
#   cp .env.example .env  후 값을 채운다. .env 는 .gitignore 에 있다.
#   ⚠ 실제 값은 Git·Notion 어디에도 적지 않는다.
#
# 읽는 곳: app/config.py (pydantic-settings). 저장소 루트의 .env 를 읽으며,
# 같은 이름의 셸 환경변수가 있으면 그쪽이 우선한다 (compose·k8s는 그 방식으로 주입).
# 아래 기본값은 config.py 의 기본값과 같다. 키를 지우면 기본값으로 동작한다.

# ── 뉴스 소스 ───────────────────────────────────────────────────────────────
# 수집 순서: GDELT → Diffbot → NewsAPI → mock (news_fetcher.py 4단계 폴백)
USE_GDELT=true
# true 면 외부 API 를 전혀 부르지 않고 fixtures/news_mock.json 을 쓴다. 로컬 개발·시연용.
USE_MOCK_NEWS=false
# USE_GDELT=false 일 때만 사용. https://newsapi.org
NEWSAPI_KEY=
# 선택. /news/{id}/source 원문 본문 추출. 없으면 원문 추출을 건너뛴다.
# (config.py 가 아니라 app/agents/diffbot_client.py 가 직접 읽는다. DIFFBOT_API_KEY 도 인정.)
DIFFBOT_TOKEN=

# ── LLM ─────────────────────────────────────────────────────────────────────
# Gemini: 카드 요약·리포트·전략·임베딩. 없으면 description 기반 fallback.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Claude: 있으면 텍스트 생성에 우선 사용, 실패 시 Gemini 로 fallback. 임베딩은 항상 Gemini.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# auto | anthropic | gemini
LLM_PROVIDER=auto
# false 면 카드 요약에 LLM 을 쓰지 않는다 (Gemini 무료 티어 5 req/min 절약).
USE_LLM_SUMMARIES=true

# ── AI 에이전트 ─────────────────────────────────────────────────────────────
# 리포트 생성 시 벡터검색으로 과거 뉴스 근거 주입. USE_MONGODB=true 가 전제.
USE_RAG=true
# 생성된 리포트를 critic 에이전트로 검증.
USE_CRITIC=true
EMBEDDING_MODEL=gemini-embedding-001

# ── MongoDB ─────────────────────────────────────────────────────────────────
# false 면 Mongo 없이 in-memory 로만 동작한다 (영속화·RAG 없음).
USE_MONGODB=false
# 예: mongodb://<app_user>:<password>@localhost:27017/capstone_news?authSource=capstone_news
# 계정·비밀번호는 capstone-deploy/.env.example 참고 (URL 안전 문자만).
MONGODB_URI=
MONGODB_DB_NAME=capstone_news

# ── 이벤트 인프라 ───────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379/0
# 프론트 개발 서버 origin. 콤마로 여러 개.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 데모 ────────────────────────────────────────────────────────────────────
# burst 부하 시연용. true 면 mock 뉴스 + 고정 처리지연으로 외부 API 변동을 제거한다.
DEMO_MODE=false
DEMO_DELAY_SECONDS=2.0

# capstone-backend 환경변수 — 값 없이 키만 커밋한다.
#   cp .env.example .env  후 값을 채운다. .env 는 .gitignore 에 있다.
#   ⚠ 실제 값은 Git·Notion 어디에도 적지 않는다.
#
# 읽는 곳: app/config.py (pydantic-settings). 저장소 루트의 .env 를 읽으며,
# 같은 이름의 셸 환경변수가 있으면 그쪽이 우선한다 (compose·k8s는 그 방식으로 주입).
# 아래 기본값은 config.py 의 기본값과 같다. 키를 지우면 기본값으로 동작한다.

# ── 뉴스 소스 ───────────────────────────────────────────────────────────────
# 검색: NAVER description·페이지 대표 이미지. 상세는 description만 표시. 리포트 요청 시 선택 기사 1건 Diffbot 추출.
NEWS_PROVIDER=naver
# NCP 콘솔 → NAVER API HUB → Application → 인증 정보 (기존 Developers 키와 다름).
# X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY 헤더로 전달한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_TIMEOUT_SECONDS=10
# USE_GDELT는 구 설정 호환용. 공급원은 NEWS_PROVIDER=naver|gdelt|newsapi로 선택.
USE_GDELT=true
# true 면 외부 API 를 전혀 부르지 않고 fixtures/news_mock.json 을 쓴다. 로컬 개발·시연용.
USE_MOCK_NEWS=false
# NEWS_PROVIDER=newsapi 또는 기존 GDELT 폴백에서 사용. https://newsapi.org
NEWSAPI_KEY=
# 리포트 요청 시 선택한 NAVER 기사 1건의 본문·이미지 추출. 검색 썸네일은 NAVER 페이지 OG 이미지에서 얻는다.
# DIFFBOT_API_KEY도 인정하며, 프로세스 환경변수 다음 .env, 토큰 파일 순으로 읽는다.
DIFFBOT_TOKEN=
DIFFBOT_SEARCH_TIMEOUT_MS=10000
DIFFBOT_SEARCH_CONCURRENCY=3

# ── LLM ─────────────────────────────────────────────────────────────────────
# Gemini: 카드 요약·리포트·전략·임베딩. 키가 없으면 카드 요약은 description,
# 리포트·전략은 생성 실패 안내용 fallback을 사용한다.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Flex 대기 시간에 맞춘 HTTP 요청 제한(초). SDK에는 밀리초로 전달한다.
GEMINI_SERVICE_TIER=flex
GEMINI_TIMEOUT_SECONDS=600
LLM_MAX_OUTPUT_TOKENS=2048
EMBEDDING_TIMEOUT_SECONDS=30
# Claude: LLM_PROVIDER=auto일 때 우선 사용. 임베딩은 항상 Gemini.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
# auto | anthropic | gemini
LLM_PROVIDER=gemini
# false 면 카드 요약에 LLM 을 쓰지 않는다 (Gemini 무료 티어 5 req/min 절약).
USE_LLM_SUMMARIES=true
# 기사별 키워드(최대 5개)·카테고리(최대 2개). false/키 없음/mock 모드는 사전 기반.
USE_LLM_METADATA=true
# 기사 하나의 AI 호출 제한 시간과 배치 내 동시 호출 수.
METADATA_TIMEOUT_SECONDS=660
METADATA_BATCH_TIMEOUT_SECONDS=660
METADATA_CONCURRENCY=3

# ── AI 에이전트 ─────────────────────────────────────────────────────────────
# 리포트 생성 시 벡터검색으로 과거 뉴스 근거 주입. USE_MONGODB=true 가 전제.
USE_RAG=true
# 생성된 리포트를 critic 에이전트로 검증.
USE_CRITIC=true
EMBEDDING_MODEL=gemini-embedding-001

# ── MongoDB ─────────────────────────────────────────────────────────────────
# 기본적으로 MongoDB를 사용한다. DB 없이 실행할 때만 false로 바꾼다 (영속화·RAG 없음).
USE_MONGODB=true
MONGODB_REQUIRED=false
# 배포 저장소의 앱 계정은 admin DB에서 생성하므로 authSource=admin을 사용한다.
# 예: mongodb://<app_user>:<password>@localhost:27017/capstone_news?authSource=admin
# 계정·비밀번호는 capstone-deploy/.env.example 참고 (URL 안전 문자만).
MONGODB_URI=
MONGODB_DB_NAME=capstone_news

# ── 이벤트 인프라 ───────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379/0
# 프론트 개발 서버 origin. 콤마로 여러 개.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 데모 ────────────────────────────────────────────────────────────────────
# burst 부하 시연용. true 면 mock 뉴스 + 고정 처리지연으로 외부 API 변동을 제거한다.
DEMO_MODE=false
DEMO_DELAY_SECONDS=2.0

# ── 세션 (쿠키 기반 사용자 식별) ────────────────────────────────────────────
# 로그인이 없어 econmind_sid 쿠키로 사용자를 구분한다. 상태는 REDIS_URL 의 Redis 에
# TTL 과 함께 저장되며, 만료 = 세션 소멸 = 마인드맵 상태 삭제다.
SESSION_TTL_SECONDS=86400
# HTTPS 로 서비스할 때 true. http 로 접속하면 true 일 때 쿠키가 아예 안 실린다.
SESSION_COOKIE_SECURE=false
# 프론트와 API 가 다른 출처면 none(+SESSION_COOKIE_SECURE=true). 같은 출처면 lax.
SESSION_COOKIE_SAMESITE=lax
